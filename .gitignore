# Terraform local data and state
**/.terraform/*
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info

# Variables that may contain secrets
*.tfvars
*.tfvars.json
.env
.env.*

# Private keys and credentials
*.pem
*.key
*.p12
*.pfx
credentials
credentials.*
.terraformrc
terraform.rc

# Saved plans and crash logs
*.tfplan
tfplan
crash.log
crash.*.log
